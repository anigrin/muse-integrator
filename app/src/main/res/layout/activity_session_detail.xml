<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chartSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/headlineScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/chartSeries"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headlineCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:paddingBottom="12dp" />

            <com.goral.museintegrator.ui.TraceChartView
                android:id="@+id/traceChart"
                android:layout_width="match_parent"
                android:layout_height="200dp" />

            <TextView
                android:id="@+id/detailBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/shareZipButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/exportZip" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
